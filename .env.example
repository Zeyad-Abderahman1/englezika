# Transactional email for the six-digit account verification code.
# For testing without a custom domain, use Resend's free test sender: "onboarding@resend.dev"
RESEND_API_KEY=re_123456789
EMAIL_FROM=Englizeka <onboarding@resend.dev>

# Long random secret used to hash verification codes. Never commit its value.
VERIFICATION_SECRET=

# Local automated tests only. Never enable this in production.
EMAIL_TEST_MODE=false

# Initial private teacher account. Generate these values outside the repository.
# No plain-text staff password is stored by the application.
INITIAL_STAFF_EMAIL=
INITIAL_STAFF_NAME=Mr Ahmed Hassan
INITIAL_STAFF_PASSWORD_HASH=
INITIAL_STAFF_PASSWORD_SALT=
INITIAL_STAFF_PASSWORD_ITERATIONS=100000
