# Transactional email for the six-digit account verification code.
# Explicit provider selection is recommended in deployed environments:
# gmail, serversmtp, resend, or gmass. Leave empty to preserve legacy auto-selection.
EMAIL_PROVIDER=

# GMass Transactional API (requires a GMass API key and a sender connected to GMass).
# API keys are secrets; generate and store them outside source control.
# IMPORTANT (DEP-04): In production, generate a dedicated production API key in the GMass dashboard.
# Any local test key used during development must be rotated/revoked in the GMass dashboard before or at launch.
GMASS_API_KEY=

# Gmail SMTP (use a Google App Password, never the normal account password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ServerSMTP/Turbo SMTP API. Use one complete key/secret pair.
SERVERSMTP_CONSUMER_KEY=
SERVERSMTP_CONSUMER_SECRET=
TURBO_SMTP_CONSUMER_KEY=
TURBO_SMTP_CONSUMER_SECRET=

# For testing without a custom domain, use Resend's free test sender: "onboarding@resend.dev"
RESEND_API_KEY=
EMAIL_FROM=Englizeka <onboarding@resend.dev>

# Long random secret used to hash verification codes. Never commit its value.
VERIFICATION_SECRET=

# Optional dedicated secret for short-lived protected video embed URLs.
# When empty, VERIFICATION_SECRET is used.
VIDEO_RESOLVE_SECRET=

# Local automated tests only. Test delivery is enabled only when this is explicitly true.
# Production rejects true and requires a complete email provider configuration.
EMAIL_TEST_MODE=false

# Initial private teacher account. Generate these values outside the repository.
# No plain-text staff password is stored by the application.
INITIAL_STAFF_EMAIL=
INITIAL_STAFF_NAME=Mr Ahmed Hassan
INITIAL_STAFF_PASSWORD_HASH=
INITIAL_STAFF_PASSWORD_SALT=
INITIAL_STAFF_PASSWORD_ITERATIONS=100000

# Fawaterak server-to-server hosted checkout. Keep these values server-side only.
# Use https://staging.fawaterk.com while testing and https://app.fawaterk.com for live payments.
FAWATERAK_BASE_URL=https://staging.fawaterk.com
FAWATERAK_CLIENT_ID=
FAWATERAK_CLIENT_SECRET=
FAWATERAK_VENDOR_API_KEY=

# Public HTTPS origin used in Fawaterak redirects and webhooks (no trailing slash).
APP_URL=
# Native PostgreSQL 16 database used locally and on the VPS.
# Windows: install PostgreSQL 16 as a Windows service, then use `npm run db:start`.
# VPS: install PostgreSQL 16 from the OS packages and use `systemctl enable --now postgresql`.
# Use a dedicated non-superuser role; never use the postgres superuser for the app.
DATABASE_URL=postgresql://englizeka:change-this-password@127.0.0.1:5432/englizeka
DATABASE_POOL_MAX=20
# Optional trusted reverse-proxy client-IP header ('x-real-ip' or 'cf-connecting-ip').
# Set to 'x-real-ip' ONLY when deployed behind Nginx/Caddy where the proxy overwrites
# the header from $remote_addr and direct client access to the Node port is blocked.
# Leave empty for local development or direct deployments to use safe fallback.
TRUSTED_PROXY_IP_HEADER=
# Maximum parallel reads inside one multi-query dashboard request (1-11).
DATABASE_READ_BATCH_CONCURRENCY=4

# Private server directory for birth certificates. Never expose it as a public static folder.
PRIVATE_STORAGE_DIR=./storage/private
