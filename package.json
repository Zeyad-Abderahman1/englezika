{
  "name": "englizeka-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "test": "npm run test:security && node --test tests/unit.test.mjs && npm run build",
    "test:security": "node --import ./tests/register-typescript-loader.mjs --test tests/*-security.test.mjs",
    "test:e2e": "node --env-file-if-exists=.env --env-file-if-exists=.env.local tests/run-live-platform-e2e.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:migrate:local": "npm run db:migrate",
    "db:up": "docker compose up -d database",
    "db:down": "docker compose stop database"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.9.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
