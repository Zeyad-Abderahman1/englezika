{
  "name": "englizeka-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/start-cluster.mjs",
    "start:single": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .next/standalone/server.js",
    "start:cluster": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/start-cluster.mjs",
    "test": "npm run test:security && node --test tests/unit.test.mjs tests/mobile-navigation-regression.test.mjs tests/recoverable-loading-regression.test.mjs && npm run build",
    "test:security": "node --import ./tests/register-typescript-loader.mjs --test tests/*-security.test.mjs",
    "test:e2e": "node --env-file-if-exists=.env --env-file-if-exists=.env.local tests/run-live-platform-e2e.mjs",
    "test:lecture-code:postgres": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./tests/register-typescript-loader.mjs --test tests/lecture-access-code-postgres.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:migrate:local": "npm run db:migrate",
    "db:start": "node scripts/db-service.mjs start",
    "db:stop": "node scripts/db-service.mjs stop",
    "bootstrap:staff": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bootstrap-initial-staff.mjs",
    "job:clean-exam-sessions": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/clean-exam-sessions.mjs",
    "job:clean-orphan-files": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/clean-orphan-private-files.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^1.25.0",
    "naqqash": "^0.2.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "puppeteer-core": "^25.9.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.9.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
